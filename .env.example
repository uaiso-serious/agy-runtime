# ==============================================================================
# Configurações do Repositório Git (entrypoint.sh - scm-runtime)
# ==============================================================================

# Tipo do servidor Git: onedev, gitlab ou github (obrigatório)
GIT_SERVER_TYPE=onedev

# URL do repositório Git a ser clonado ao iniciar o container (HTTP/HTTPS)
GIT_REPO_URL=http://onedev.uaiso.lan/tonho.git

# Token de acesso pessoal (PAT / Access Token) para autenticação em operações de clone, pull e push
GIT_TOKEN=seu_token_aqui

# (Opcional) Usuário utilizado na autenticação HTTP junto ao GIT_TOKEN (padrão: git)
# GIT_USERNAME=git

# Branch base que será clonada do repositório remoto (obrigatório)
GIT_BASE_BRANCH=main

# Nome da branch de trabalho (obrigatório se ISSUE_ID não estiver definido)
GIT_BRANCH=feat/minha-feature

# Identidade do autor para commits realizados dentro do container (obrigatório)
GIT_USER_NAME=tonho
GIT_USER_EMAIL=tonho@localhost

# (Opcional) Co-autor humano dos commits
# GIT_CO_AUTHOR=Some human <somehuman@example.com>

# (Opcional) ID da issue e modo autônomo
# ISSUE_ID=123
# AUTONOMOUS_MODE=true

# ==============================================================================
# Configurações do Runtime (agy.sh)
# ==============================================================================

# (Opcional) Prompt inicial enviado ao agy (-p no autônomo, -i no interativo)
# ISSUE_PROMPT=Resolva a issue

# (Opcional) Incluir comentários da issue (/tmp/issue/comments.md) no contexto
# ISSUE_COMMENTS=true

# (Opcional) Modelo do Antigravity CLI (consulte `agy models`)
# MODEL=gemini-4-argon-medium

# ==============================================================================
# Telemetria Langfuse On-Premise / Cloud (plugin langfuse-observability)
# ==============================================================================

# LANGFUSE_BASE_URL=http://seu-langfuse-onprem:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_USER_ID=some-user
